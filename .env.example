# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
DB_PATH=database/frontpage.db

# CORS Configuration
CORS_ORIGIN=*

# Feed Polling & Cache Settings
CACHE_TTL_MINUTES=15
FEED_FETCH_TIMEOUT_MS=10000

# Optional Google Gemini AI Key (if omitted, smart local extractive engine is used)
GEMINI_API_KEY=
